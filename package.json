{
  "name": "@refy/ui",
  "version": "0.4.0",
  "description": "Refy Design System — componentes React atômicos.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./global.css": "./src/styles/global.css",
    "./tokens.json": "./src/tokens/foundations.tokens.json",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "check:specs": "node scripts/check-specs.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "check": "npm run tokens:check && npm run contrast:check && npm run lint && npm run build && node scripts/check.mjs",
    "prepack": "npm run build",
    "tokens:build": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "test:browser": "playwright test",
    "contrast:check": "node scripts/check-contrast.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^8.6.19",
    "typescript": "^5.5.0",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens/tokens.css",
    "src/styles/global.css",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "src/tokens/foundations.tokens.json",
    "src/styles/fonts.css"
  ],
  "author": "Vinícius Coimbra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciuscoimbra/refy-ui.git"
  },
  "homepage": "https://github.com/viniciuscoimbra/refy-ui#readme",
  "bugs": {
    "url": "https://github.com/viniciuscoimbra/refy-ui/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
